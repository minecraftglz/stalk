# 后端端口（生产 Docker 中固定 8080）
PORT=8080

# 鉴权密钥 - 所有 Agent 必须与此一致
SECRET_KEY=change-me-in-production

# 城市名 - 用于天气显示（英文或拼音）；留空则按服务器公网 IP 自动定位
WEATHER_CITY=

# 和风天气 API Key（可选，不配则用 wttr.in 免费接口；空气质量用 open-meteo 免费接口）
# WEATHER_KEY=

# ===== AI =====
# provider：openai = 通用 OpenAI 兼容接口；ollama = 本地 Ollama
# 云端预设（只需填 AI_API_KEY，URL 与默认模型自动带出）：
#   zhipu       智谱 BigModel   → glm-5.3-flash（约 0.8 / 2.8 元每百万 tokens）
#                               想零成本就加 AI_MODEL=glm-4.7-flash（200K 上下文，完全免费，高峰期可能 429）
#   siliconflow 硅基流动         → zai-org/GLM-5.3-Flash（9B 以下小模型限速免费，新用户有赠金）
#   deepseek    DeepSeek         → deepseek-chat
AI_PROVIDER=openai

# OpenAI 兼容接口（AI_PROVIDER=openai 时生效）
# AI_API_URL=https://api.deepseek.com/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=deepseek-chat

# 云端预设示例：换成下面的即可（AI_MODEL 不填则用该平台默认模型）
# AI_PROVIDER=zhipu
# AI_API_KEY=你的Key

# 本地 Ollama（AI_PROVIDER=ollama 时生效）
# 本机跑 Ollama 用 http://localhost:11434；docker-compose 里改为 http://ollama:11434
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
